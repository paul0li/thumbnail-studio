# Copy to .env and adjust. Every value here is a placeholder.

# Where the library database and photos live. Never inside a tracked folder.
STUDIO_DATA_DIR=./data

# The server binds to loopback by default. Reach it from other devices through
# a proxy such as `tailscale serve`, not by binding to 0.0.0.0.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8000

# Cutting people out: `none` (default) or `rembg` (needs `uv sync --extra cutout`
# and the u2net model in U2NET_HOME).
STUDIO_CUTOUT_PROVIDER=none
# U2NET_HOME=/path/to/models

# Upload limits.
STUDIO_MAX_UPLOAD_BYTES=26214400
STUDIO_MAX_IMAGE_PIXELS=40000000

# «Mejorar» (ADR 0010). The image engine is OpenAI's Images API. Without a key
# the button still shows, and says that the improvement is not configured.
# The key is never logged or returned.
# OPENAI_API_KEY=sk-your-key-here
STUDIO_OPENAI_IMAGE_MODEL=gpt-image-2
# low, medium, high or auto. About $0.15-0.20 per improvement at high,
# about $0.05 at medium (OpenAI's prices on 2026-10-28).
STUDIO_OPENAI_IMAGE_QUALITY=high
STUDIO_OPENAI_IMAGE_SIZE=1536x864
STUDIO_OPENAI_TIMEOUT_SECONDS=240

# The result is read back by a headless Claude Code session, signed in with
# the installation owner's own plan. The command is split like a shell would;
# never put a secret in it.
STUDIO_CLAUDE_COMMAND=claude
STUDIO_CLAUDE_MODEL=opus
STUDIO_CLAUDE_TIMEOUT_SECONDS=180
